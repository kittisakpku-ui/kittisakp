rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kittisakpku@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isPlanningOrAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.department == 'งานยุทธศาสตร์และบุคคล' ||
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'finance_officer'
          )
        )
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection verification endpoint
    match /test/{testId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /projectSummaries/{summaryId} {
      allow read, write: if true;
    }

    match /disbursements/{disbursementId} {
      allow read, write: if true;
    }

    match /transfers/{transferId} {
      allow read, write: if true;
    }

    match /members/{memberId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
