rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kittisakpku@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isPlanningOrAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.department == 'งานยุทธศาสตร์และบุคคล' ||
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'finance_officer'
          )
        )
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /projectSummaries/{summaryId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isPlanningOrAdmin() || (
        isSignedIn() && (
          resource.data.responsibleEmail == request.auth.token.email ||
          resource.data.createdBy == request.auth.token.email
        )
      );
    }

    match /disbursements/{disbursementId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /transfers/{transferId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /members/{memberId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == memberId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }
  }
}
